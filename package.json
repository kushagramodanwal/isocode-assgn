{
  "name": "kirana-orders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch --clear-screen=false server/src/index.ts\" \"vite\"",
    "build": "prisma generate && vite build && esbuild server/src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "ai:check": "tsx scripts/check-ai.ts",
    "eval": "tsx scripts/eval-capture.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@prisma/client": "6.19",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "lucide-react": "^0.468.0",
    "react": "19.1",
    "react-dom": "19.1",
    "react-router-dom": "^7.18.5",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prisma": "6.19",
    "supertest": "^7.3.1",
    "tailwindcss": "4.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "3.2"
  },
  "engines": {
    "node": ">=20"
  }
}
