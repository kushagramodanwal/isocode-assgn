generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  RETAILER
  DESK
  SALESMAN
}

enum Lang {
  en
  hi
}

enum PriceTier {
  STANDARD
  PREMIUM
}

enum SchemeType {
  FREE_GOODS
  SLAB_DISCOUNT
}

enum OrderSource {
  APP
  CAPTURE
  SALESMAN
}

enum OrderStatus {
  PENDING_REVIEW
  CREDIT_HOLD
  CONFIRMED
  EXPORTED
  CANCELLED
}

enum Channel {
  WHATSAPP_MOCK
  IN_APP
}

enum MessageStatus {
  NEW
  PARSED
  CONVERTED
  DISCARDED
}

enum ParserKind {
  LLM
  RULE
}

enum DraftStatus {
  OPEN
  CONFIRMED
  DISCARDED
}

enum CaptureUnit {
  CASE
  PIECE
  UNKNOWN
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String
  role          Role
  preferredLang Lang      @default(en)
  retailerId    String?
  retailer      Retailer? @relation("RetailerUsers", fields: [retailerId], references: [id])
  createdAt     DateTime  @default(now())

  ordersCreated   Order[]       @relation("OrderCreatedBy")
  ordersConfirmed Order[]       @relation("OrderConfirmedBy")
  exports         TallyExport[]
  auditLogs       AuditLog[]
  salesRetailers  Retailer[]    @relation("Salesman")
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

model Retailer {
  id               String    @id @default(cuid())
  shopName         String
  ownerName        String
  phone            String    @unique
  area             String
  route            String
  segment          String?
  priceTier        PriceTier @default(STANDARD)
  creditLimitPaise Int
  outstandingPaise Int       @default(0)
  tallyLedgerName  String
  salesmanId       String?
  salesman         User?     @relation("Salesman", fields: [salesmanId], references: [id])

  users     User[]           @relation("RetailerUsers")
  orders    Order[]
  messages  InboundMessage[]
  aliases   RetailerAlias[]
  overrides RetailerPrice[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id       String @id @default(cuid())
  brandId  String
  brand    Brand  @relation(fields: [brandId], references: [id])
  name     String
  nameHi   String
  category String
  imageUrl String
  skus     Sku[]
}

model Sku {
  id             String  @id @default(cuid())
  code           String  @unique
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  packLabel      String
  packGrams      Int // normalised size (g or ml) used by capture size matching
  unitsPerCase   Int
  unitPricePaise Int
  gstRateBps     Int
  stockCases     Int
  allowPieces    Boolean @default(false)
  active         Boolean @default(true)

  tierPrices     TierPrice[]
  retailerPrices RetailerPrice[]
  schemes        Scheme[]
  orderLines     OrderLine[]
  aliases        RetailerAlias[]
}

model TierPrice {
  tier           PriceTier
  skuId          String
  sku            Sku       @relation(fields: [skuId], references: [id])
  unitPricePaise Int

  @@id([tier, skuId])
}

/// Per-retailer override on top of the tier price (A-09).
model RetailerPrice {
  retailerId     String
  retailer       Retailer @relation(fields: [retailerId], references: [id])
  skuId          String
  sku            Sku      @relation(fields: [skuId], references: [id])
  unitPricePaise Int

  @@id([retailerId, skuId])
}

model Scheme {
  id        String     @id @default(cuid())
  skuId     String
  sku       Sku        @relation(fields: [skuId], references: [id])
  type      SchemeType
  params    Json
  validFrom DateTime
  validTo   DateTime
  segment   String?
  labelEn   String
  labelHi   String

  @@index([skuId])
}

model Counter {
  key   String @id
  value Int
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  retailerId     String
  retailer       Retailer    @relation(fields: [retailerId], references: [id])
  source         OrderSource
  status         OrderStatus
  taxablePaise   Int
  discountPaise  Int
  gstPaise       Int
  totalPaise     Int
  createdById    String
  createdBy      User        @relation("OrderCreatedBy", fields: [createdById], references: [id])
  confirmedById  String?
  confirmedBy    User?       @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt    DateTime?
  cancelReason   String?
  holdReleasedAt DateTime?
  repeatOfId     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  lines  OrderLine[]
  drafts CaptureDraft[]

  @@index([retailerId, createdAt])
  @@index([status, createdAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId          String
  sku            Sku     @relation(fields: [skuId], references: [id])
  qtyCases       Int
  freeCases      Int     @default(0)
  unitPricePaise Int
  unitsPerCase   Int
  discountPaise  Int     @default(0)
  gstRateBps     Int
  gstPaise       Int
  lineTotalPaise Int
  schemeId       String?
  schemeSnapshot Json?
}

model InboundMessage {
  id         String         @id @default(cuid())
  retailerId String?
  retailer   Retailer?      @relation(fields: [retailerId], references: [id])
  fromPhone  String
  channel    Channel
  rawText    String
  receivedAt DateTime       @default(now())
  status     MessageStatus  @default(NEW)
  drafts     CaptureDraft[]

  @@index([retailerId, receivedAt])
}

model CaptureDraft {
  id         String         @id @default(cuid())
  messageId  String
  message    InboundMessage @relation(fields: [messageId], references: [id])
  parserUsed ParserKind
  parserNote String?
  status     DraftStatus    @default(OPEN)
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])
  createdAt  DateTime       @default(now())
  lines      CaptureLine[]
}

model CaptureLine {
  id                String       @id @default(cuid())
  draftId           String
  draft             CaptureDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  position          Int
  originalText      String
  normalisedPhrase  String
  proposedSkuId     String?
  alternativeSkuIds String[]
  qty               Int?
  unit              CaptureUnit
  confidence        Confidence
  confidenceSignals Json
  issues            String[]
  resolvedSkuId     String?
  resolvedQty       Int?
  resolvedUnit      CaptureUnit?
  removed           Boolean      @default(false)

  @@index([draftId, position])
}

model RetailerAlias {
  id          String   @id @default(cuid())
  retailerId  String
  retailer    Retailer @relation(fields: [retailerId], references: [id])
  phrase      String
  skuId       String
  sku         Sku      @relation(fields: [skuId], references: [id])
  createdFrom String   @default("DESK_CORRECTION")
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([retailerId, phrase])
}

model TallyExport {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  orderIds    String[]
  format      String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  actor    User     @relation(fields: [actorId], references: [id])
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
}
