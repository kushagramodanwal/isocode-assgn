# Names only. Copy to .env and fill in.
DATABASE_URL=
# Separate DB for Vitest integration tests (wiped on each run)
TEST_DATABASE_URL=
# >= 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# true = log OTPs to console, seeded demo users accept 123456, show demo hint on login
DEMO_MODE=
# anthropic | gemini | none  (none or missing key => deterministic RuleParser)
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override
LLM_MODEL=
# Public origin used for the CSRF origin check, e.g. https://example.vercel.app
APP_ORIGIN=
