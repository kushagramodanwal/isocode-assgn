# Names only. Copy to .env and fill in values locally. Never commit .env.
DATABASE_URL=
# Separate database for integration tests (tests create their own rows in it)
TEST_DATABASE_URL=
# >= 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# true = OTPs are shown on the login screen (SMS is mocked). Use false in production.
DEMO_MODE=
# gemini | none. "none" (or no key) uses the built-in rule-based reader.
LLM_PROVIDER=
# Google AI Studio key (https://aistudio.google.com/apikey). Free tier works.
GEMINI_API_KEY=
# Optional model override (default gemini-3.5-flash-lite)
LLM_MODEL=
# Optional AI timeout in ms (default 15000); on timeout the rule-based reader is used
LLM_TIMEOUT_MS=
# API port (default 4000)
PORT=
# Allowed web origin(s) for state-changing requests, comma separated (e.g. https://orders.example.in)
APP_ORIGIN=
