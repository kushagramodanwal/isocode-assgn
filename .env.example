# Server Configuration
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retailer_db

# Authentication & Sessions
SESSION_SECRET=super-secret-fmcg-retailer-session-key-32chars-min
DEV_OTP_ENABLED=true
DEMO_OTP_CODE=123456
COOKIE_SECURE=false

# External Adapters (mock | real)
MESSAGING_PROVIDER=mock
PAYMENT_PROVIDER=mock
LLM_PROVIDER=mock

# Live LLM credentials (used when LLM_PROVIDER is gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
